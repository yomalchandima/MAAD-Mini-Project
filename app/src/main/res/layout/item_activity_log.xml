<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivLogIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_social_button"
        android:padding="6dp"
        android:src="@drawable/ic_bolt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vibrant_cyan"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvLogDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Smart Clothing Iron"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvLogTime"
        app:layout_constraintStart_toEndOf="@id/ivLogIcon"
        app:layout_constraintTop_toTopOf="@id/ivLogIcon" />

    <TextView
        android:id="@+id/tvLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2m ago"
        android:textColor="@color/soft_gray"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvLogDeviceName" />

    <TextView
        android:id="@+id/tvLogAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="SAFETY_SHUTDOWN"
        android:textColor="@color/vibrant_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvLogPerformedBy"
        app:layout_constraintStart_toStartOf="@id/tvLogDeviceName"
        app:layout_constraintTop_toBottomOf="@id/tvLogDeviceName" />

    <TextView
        android:id="@+id/tvLogPerformedBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_social_button"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:text="safety-system"
        android:textColor="@color/soft_gray"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@id/tvLogAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvLogAction" />

    <TextView
        android:id="@+id/tvLogDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Smart Clothing Iron automatically shut down after reaching maximum duration."
        android:textColor="@color/soft_gray"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvLogDeviceName"
        app:layout_constraintTop_toBottomOf="@id/tvLogAction" />

</androidx.constraintlayout.widget.ConstraintLayout>
