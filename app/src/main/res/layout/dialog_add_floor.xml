<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_new_floor"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFloorName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Floor Name"
        app:boxStrokeColor="@color/vibrant_cyan"
        app:hintTextColor="@color/vibrant_cyan">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFloorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/select_floor_plan"
        android:textColor="@color/soft_gray"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgFloorPlans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbGroundPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/plan_ground_floor"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/rbFirstPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plan_first_floor"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/rbStudioPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plan_studio"
            android:textColor="@color/white" />
    </RadioGroup>

</LinearLayout>
