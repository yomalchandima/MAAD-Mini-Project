<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_midnight"
    tools:context=".ui.report.ReportsActivity">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/bg_social_circle"
            android:padding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/vibrant_cyan"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toTopOf="@id/ivLogo">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lumina"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Analytics"
                android:textColor="@color/vibrant_cyan"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_bell"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_person"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/energy_analytics"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_social_button"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/weekly"
                    android:textColor="@color/vibrant_cyan"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_layers"
                    app:drawableTint="@color/vibrant_cyan"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTitle" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Efficiency Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_dark"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvReportLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_social_button"
                    android:backgroundTint="#2000E5FF"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/efficiency_report"
                    android:textColor="@color/vibrant_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_bolt"
                    app:drawableTint="@color/vibrant_cyan"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMainMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/efficiency_msg"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvReportLabel" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/efficiency_sub"
                    android:textColor="@color/soft_gray"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/tvMainMsg" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvKwhLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kwh_today_label"
                        android:textColor="@color/soft_gray"
                        android:textSize="10sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_back"
                        android:rotation="-45"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/vibrant_cyan" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="bottom"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvKwhLabel">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kwh_today_val"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="2dp"
                            android:text="kWh"
                            android:textColor="@color/soft_gray"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCostLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/est_cost_label"
                        android:textColor="@color/soft_gray"
                        android:textSize="10sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_back"
                        android:rotation="135"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#FF8A80" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="bottom"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCostLabel">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/est_cost_val"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="2dp"
                            android:text="@string/per_mo"
                            android:textColor="@color/soft_gray"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <!-- Weekly Usage Chart Placeholder -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_dark"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekly_usage"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_social_button"
                    android:backgroundTint="#2000E5FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="↓ 8%"
                    android:textColor="@color/vibrant_cyan"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvChartTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvChartTitle" />

                <!-- Simulating a chart -->
                <View
                    android:id="@+id/chartMock"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_gradient_button"
                    android:alpha="0.2"
                    app:layout_constraintTop_toBottomOf="@id/tvChartTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/chartMock">
                    <TextView style="@style/ChartDayLabel" android:text="Mon" />
                    <TextView style="@style/ChartDayLabel" android:text="Tue" />
                    <TextView style="@style/ChartDayLabel" android:text="Wed" />
                    <TextView style="@style/ChartDayLabel" android:text="Thu" />
                    <TextView style="@style/ChartDayLabel" android:text="Fri" />
                    <TextView style="@style/ChartDayLabel" android:text="Sat" />
                    <TextView style="@style/ChartDayLabel" android:text="Sun" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Device Load Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_dark"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvLoadTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_load"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tvLoadTitle">

                    <View
                        android:id="@+id/donutMock"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_social_circle"
                        android:backgroundTint="@color/vibrant_cyan"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14.2\nkWh"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:gravity="center"
                        app:layout_constraintBottom_toBottomOf="@id/donutMock"
                        app:layout_constraintEnd_toEndOf="@id/donutMock"
                        app:layout_constraintStart_toStartOf="@id/donutMock"
                        app:layout_constraintTop_toTopOf="@id/donutMock" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/donutMock"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/LoadItem">
                            <View style="@style/LoadIndicator" android:backgroundTint="@color/vibrant_cyan" />
                            <TextView style="@style/LoadLabel" android:text="@string/climate" />
                            <TextView style="@style/LoadPercent" android:text="@string/percent_45" />
                        </LinearLayout>

                        <LinearLayout style="@style/LoadItem">
                            <View style="@style/LoadIndicator" android:backgroundTint="#FF8A80" />
                            <TextView style="@style/LoadLabel" android:text="@string/kitchen" />
                            <TextView style="@style/LoadPercent" android:text="@string/percent_35" />
                        </LinearLayout>

                        <LinearLayout style="@style/LoadItem">
                            <View style="@style/LoadIndicator" android:backgroundTint="#A58AFF" />
                            <TextView style="@style/LoadLabel" android:text="@string/smart_lights" />
                            <TextView style="@style/LoadPercent" android:text="@string/percent_20" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Top Consumers Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/top_consumers"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout style="@style/ConsumerCard">
                <ImageView
                    android:id="@+id/ivHvac"
                    style="@style/ConsumerIcon"
                    android:src="@drawable/ic_ac"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvHvacName"
                    style="@style/ConsumerName"
                    android:text="@string/hvac_system"
                    app:layout_constraintStart_toEndOf="@id/ivHvac"
                    app:layout_constraintTop_toTopOf="@id/ivHvac" />
                <TextView
                    style="@style/ConsumerUsage"
                    android:text="@string/hvac_usage"
                    app:layout_constraintStart_toStartOf="@id/tvHvacName"
                    app:layout_constraintTop_toBottomOf="@id/tvHvacName" />
                <TextView
                    style="@style/ConsumerTrend"
                    android:text="↑ 4%"
                    android:textColor="#FF8A80"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout style="@style/ConsumerCard">
                <ImageView
                    android:id="@+id/ivWater"
                    style="@style/ConsumerIcon"
                    android:src="@drawable/ic_bath"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvWaterName"
                    style="@style/ConsumerName"
                    android:text="@string/water_heater"
                    app:layout_constraintStart_toEndOf="@id/ivWater"
                    app:layout_constraintTop_toTopOf="@id/ivWater" />
                <TextView
                    style="@style/ConsumerUsage"
                    android:text="@string/water_heater_usage"
                    app:layout_constraintStart_toStartOf="@id/tvWaterName"
                    app:layout_constraintTop_toBottomOf="@id/tvWaterName" />
                <TextView
                    style="@style/ConsumerTrend"
                    android:text="↓ 2%"
                    android:textColor="@color/vibrant_cyan"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout style="@style/ConsumerCard">
                <ImageView
                    android:id="@+id/ivEv"
                    style="@style/ConsumerIcon"
                    android:src="@drawable/ic_bolt"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvEvName"
                    style="@style/ConsumerName"
                    android:text="@string/ev_charger"
                    app:layout_constraintStart_toEndOf="@id/ivEv"
                    app:layout_constraintTop_toTopOf="@id/ivEv" />
                <TextView
                    style="@style/ConsumerUsage"
                    android:text="@string/ev_charger_usage"
                    app:layout_constraintStart_toStartOf="@id/tvEvName"
                    app:layout_constraintTop_toBottomOf="@id/tvEvName" />
                <TextView
                    style="@style/ConsumerTrend"
                    android:text="— 0%"
                    android:textColor="@color/soft_gray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View android:layout_width="match_parent" android:layout_height="40dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/surface_container"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>